{
  "headers": [
    {
      "source": "/vagas/editor",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/vagas/editor/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/"
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "shiftlabs.digital"
        }
      ],
      "destination": "https://shiftlabs.sh/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.shiftlabs.digital"
        }
      ],
      "destination": "https://shiftlabs.sh/:path*",
      "permanent": true
    }
  ]
}
